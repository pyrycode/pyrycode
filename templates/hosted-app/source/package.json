{
  "name": "pyry-hosted-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.15.0 <25.0.0" },
  "devEngines": { "runtime": { "name": "node", "version": ">=24.15.0 <25.0.0", "onFail": "error" } },
  "scripts": {
    "preinstall": "node src/service/runtime.mjs",
    "typecheck": "node src/service/runtime.mjs && tsc -p tsconfig.web.json && tsc -p tsconfig.service.json --noEmit",
    "test": "node src/service/runtime.mjs && tsc -p tsconfig.service.json && node --test --test-reporter=tap test/*.test.mjs",
    "build": "node scripts/build.mjs",
    "start": "node dist/service/main.js",
    "migrate": "node dist/service/migrate.js",
    "health": "node dist/service/health.js",
    "smoke:browser": "node scripts/browser-smoke.mjs"
  },
  "dependencies": { "react": "19.3.0", "react-dom": "19.3.0" },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild-wasm": "0.28.2",
    "playwright-core": "1.61.1",
    "typescript": "6.0.3"
  }
}
