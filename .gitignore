# Build artifacts
/pyry
/dist/
/substrate-guard
/cite-guard
*.test
*.out

# Flight-recorder session recordings (PYRY_RECORD_DIR, #552). Belt-and-
# suspenders: the production default lives outside the repo, but if an operator
# points PYRY_RECORD_DIR inside the tree while debugging, recordings (which can
# contain full session content) never get committed.
*.cast

# Go
/vendor/

# Editors
.vscode/
.idea/
*.swp

# OS
.DS_Store

# Scratchpad artifacts (e.g. redirect targets of local e2e verification loops).
# Kept out of the tree so the dispatcher's "auto-commit uncommitted changes"
# sweep can't land them in a branch (it committed scratchpad_958_e2e_loop.log
# into feature/958, commit f1736c4).
scratchpad_*
*.log

# Local env
.env
.env.local

# MCP config (machine-specific paths)
.mcp.json

# Agents (separate repo: pyrycode/agents)
agents/

# CodeGraph index (used by dispatcher worktree symlink + interactive
# Claude Code sessions for symbol-level code intel — local cache only).
# No trailing slash: matches both directories AND symlinks. The trailing
# slash variant `.codegraph/` matches directories only, which let the
# dispatcher's worktree symlink at `<wt>/.codegraph` slip past gitignore
# and get auto-committed (commit 30f3d53, "architect: auto-commit
# uncommitted changes for #237"). Result: a tracked symlink-to-self
# that `git checkout -- .` kept restoring on every cleanup.
.codegraph
.dispatcher.lock

# Permission-protocol spike output. TestRealClaude_PermissionProtocol_Spike is
# NOT env-gated — it skips only when the claude binary is off PATH — so every
# `make e2e-realclaude` run rewrites permission_protocol_v<version>.json into
# testdata/. Nothing reads those files: permission_protocol_regression_test.go
# consumes only the `_<mode>`-suffixed fixtures, which the negation below keeps
# tracked. Two unsuffixed captures had already been swept in by the dispatcher's
# auto-commit safety net inside unrelated tickets — v2.1.158 in 7907031 (#747)
# and v2.1.199 in d0d24f8 (#854) — which is the same failure mode as the
# .codegraph entry above: a regenerating local artifact riding into someone
# else's commit. Already-tracked files are unaffected; this only stops new ones.
internal/e2e/realclaude/testdata/permission_protocol_v*.json
!internal/e2e/realclaude/testdata/permission_protocol_v*_*.json
